# Neon Postgres — use the pooled connection string (with ?pgbouncer=true) from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/rigorworks?sslmode=require&pgbouncer=true"

# Cloudflare R2 (S3-compatible) — from the R2 bucket's "Manage API tokens"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="rigorworks-resumes"

# Resend — from the Resend dashboard, sending domain must be verified
RESEND_API_KEY="re_your_resend_api_key"
NOTIFY_EMAIL="hello@rigorworks.com"
FROM_EMAIL="RigorWorks Website <noreply@rigorworks.com>"

# Admin login for /login — generate the hash with `npm run hash-password`
ADMIN_EMAIL="you@rigorworks.com"
ADMIN_PASSWORD_HASH="$2a$10$replace-with-generated-bcrypt-hash"

# Random long string, e.g. `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS="https://neerajnegi11.github.io,http://localhost:8080"
